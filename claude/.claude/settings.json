{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git stash list)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(but status:*)",
      "Bash(but log:*)",
      "Bash(but diff:*)",
      "Bash(but show:*)",
      "Bash(but branch:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(cp:*)",
      "mcp__plugin_context7_*",
      "Skill(frontend-design:frontend-design)"
    ],
    "defaultMode": "default"
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c '\"/opt/homebrew/bin/bun\" \"$(ls -td ~/.claude/plugins/cache/claude-hud/claude-hud/*/ 2>/dev/null | head -1)src/index.ts\"'"
  },
  "enabledPlugins": {
    "always-works-testing@florin-popa-marketplace": true,
    "ast-grep@ast-grep-marketplace": false,
    "code-review@claude-plugins-official": false,
    "commit-commands@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "rails-codegen@florin-popa-marketplace": true,
    "cognitive-load@florin-popa-marketplace": true,
    "simplicity-first@florin-popa-marketplace": true,
    "typescript-lsp@claude-plugins-official": true,
    "cloudflare-toolkit@florin-popa-marketplace": false,
    "sentry-skills@sentry-skills": true,
    "claude-hud@claude-hud": true,
    "context7@claude-plugins-official": true,
    "astral@astral-sh": true,
    "clangd-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "impeccable@impeccable": true,
    "context-mode@claude-context-mode": true
  },
  "extraKnownMarketplaces": {
    "florin-popa-marketplace": {
      "source": {
        "source": "github",
        "repo": "FlorinPopaCodes/claude-marketplace"
      }
    },
    "ast-grep-marketplace": {
      "source": {
        "source": "github",
        "repo": "ast-grep/claude-skill"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
  },
  "sandbox": {
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "docker"
    ]
  }
}
