# === ZINIT SETUP ===
{{ if eq .chezmoi.os "darwin" -}}
source $HOMEBREW_PREFIX/opt/zinit/zinit.zsh
{{ else -}}
source /usr/share/zinit/zinit.zsh
{{ end }}
# === SHELL OPTIONS ===
setopt AUTO_CD              # cd by typing directory name
setopt AUTO_PUSHD           # cd pushes to directory stack
setopt PUSHD_IGNORE_DUPS    # No duplicates in dir stack
setopt PUSHD_SILENT         # Don't print stack after pushd/popd
setopt CORRECT              # Spell correction for commands

# === HISTORY ===
HISTSIZE=50000
SAVEHIST=50000
HISTFILE=~/.zsh_history
setopt SHARE_HISTORY        # Share history between sessions
setopt HIST_IGNORE_ALL_DUPS # Remove older duplicate entries
setopt HIST_IGNORE_SPACE    # Ignore commands starting with space
setopt HIST_REDUCE_BLANKS   # Remove superfluous blanks
setopt HIST_VERIFY          # Show before executing history commands

# === OH-MY-ZSH SNIPPETS (turbo mode) ===
zinit wait lucid for \
    OMZP::colored-man-pages \
    OMZP::command-not-found \
    OMZP::copyfile \
    OMZP::copypath \
    OMZP::docker \
    OMZP::docker-compose \
    OMZP::extract \
    OMZP::git \
    OMZP::gitignore \
    OMZP::golang \
    OMZP::jsontools \
    OMZP::rust \
    OMZP::safe-paste \
    OMZP::sudo \
    OMZP::universalarchive
{{ if eq .chezmoi.os "darwin" }}
zinit wait lucid for \
    OMZP::brew \
    OMZP::bundler \
    OMZP::gem
{{ end -}}

# Kubernetes (defer 1 second - not always needed immediately)
zinit wait"1" lucid for \
    OMZP::kube-ps1 \
    OMZP::kubectl

# === COMPLETIONS (turbo mode) ===
zinit wait lucid for \
    blockf \
    atload"zicompinit; zicdreplay" \
  zsh-users/zsh-completions

# === AUTOSUGGESTIONS + SYNTAX HIGHLIGHTING ===
zinit wait lucid for \
    atload"_zsh_autosuggest_start" \
  zsh-users/zsh-autosuggestions

zinit wait"0b" lucid for \
  zsh-users/zsh-syntax-highlighting

# === IMMEDIATE TOOLS (must run before prompt) ===
eval "$(starship init zsh)"

# === DEFERRED TOOLS (turbo mode - run after prompt) ===
zinit wait lucid for \
    atload'eval "$(direnv hook zsh)"' \
{{- if eq .chezmoi.os "darwin" }}
    atload'eval "$(rbenv init - zsh)"' \
{{- end }}
    atload'eval $(thefuck --alias f)' \
    atload'eval "$(zoxide init zsh --cmd cd)"' \
  zdharma-continuum/null

# === CONDITIONAL DEFERRED TOOLS ===
if command -v pnpm &>/dev/null; then
    zinit wait lucid for atload'eval "$(pnpm completion zsh)"' zdharma-continuum/null
fi

if command -v ngrok &>/dev/null; then
    zinit wait lucid for atload'eval "$(ngrok completion)"' zdharma-continuum/null
fi
{{ if eq .chezmoi.os "darwin" }}
if command -v gcloud &>/dev/null; then
    source "$(brew --prefix)/share/google-cloud-sdk/path.zsh.inc"
    source "$(brew --prefix)/share/google-cloud-sdk/completion.zsh.inc"
fi
{{ end -}}

# === FUNCTIONS ===
# Clone GitHub repos to ~/Developer/owner/repo
ghc() {
   local pat='github\.com[:/]([^/]+)/([^/.]+)'
   [[ "$1" =~ $pat ]] || {
     echo "Invalid GitHub URL" >&2
     return 1
   }
   local dest="$HOME/Developer"
   dest+="/${match[1]}/${match[2]%.git}"
   git clone "$1" "$dest" && cd "$dest"
 }

# === ALIASES ===
# Modern ls with eza
alias ls="eza --icons"
alias ll="eza -la --icons --git"
alias la="eza -a --icons"
alias tree="eza --tree --icons"

# Modern cd with zoxide
alias j="cd"
alias ji="cdi"
alias c="claude"
alias cc="claude -c"
alias z="zed"
alias _="sudo"

# === ENVIRONMENT ===
export EDITOR="nvim"
{{ if eq .chezmoi.os "darwin" -}}
export HOMEBREW_NO_AUTO_UPDATE=1
{{ end -}}
export BAT_THEME="gruvbox-dark"

# === 1PASSWORD SSH AGENT ===
{{ if eq .chezmoi.os "darwin" -}}
export SSH_AUTH_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{ else -}}
export SSH_AUTH_SOCK="$HOME/.1password/agent.sock"
{{ end }}
# === CONDITIONAL PATHS ===
[[ -d "$HOME/.duckdb/cli/latest" ]] && export PATH="$HOME/.duckdb/cli/latest:$PATH"
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"
[[ -d "$HOME/.amp/bin" ]] && export PATH="$HOME/.amp/bin:$PATH"

# === ATUIN ===
. "$HOME/.atuin/bin/env"
eval "$(atuin init zsh)"

# === LOCAL OVERRIDES ===
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
