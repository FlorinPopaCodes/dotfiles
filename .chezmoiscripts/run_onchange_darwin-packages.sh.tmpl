{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -uo pipefail
# Hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

echo "Installing packages via brew bundle..."

# Allow partial failures (e.g. MAS apps needing sudo in non-TTY)
brew bundle --file=/dev/stdin <<EOF || true
{{ range .darwin.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .darwin.mas -}}
mas {{ .name | quote }}, id: {{ .id }}
{{ end -}}
EOF
{{ end -}}
