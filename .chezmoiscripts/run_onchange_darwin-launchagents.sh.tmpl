{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
set -euo pipefail
# Hash: {{ include "private_Library/LaunchAgents/com.florinpopa.autopull.plist" | sha256sum }}

echo "Installing LaunchAgents..."

for plist in ~/Library/LaunchAgents/com.florinpopa.*.plist; do
    [[ -f "$plist" ]] || continue
    name=$(basename "$plist")
    label="${name%.plist}"
    launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "  Installed: $name"
done

echo "LaunchAgents installed."
{{ end -}}
